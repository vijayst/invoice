{
  "name": "@vijayst/invoice-studio",
  "version": "1.0.0",
  "description": "Invoice Studio — Markdown invoice templates with MCP tools for interactive editing and headless PDF generation",
  "license": "ISC",
  "author": "Vijay",
  "type": "module",
  "mcpName": "io.github.vijayst/invoice-studio",
  "main": "dist/index.js",
  "bin": {
    "invoice-studio-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "scripts",
    "src",
    "AGENTS.md",
    "README.md",
    "server.json",
    "smithery.yaml"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vijayst/invoice.git"
  },
  "homepage": "https://github.com/vijayst/invoice",
  "bugs": {
    "url": "https://github.com/vijayst/invoice/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:mcp": "tsc -p tsconfig.json",
    "start:mcp": "node dist/index.js",
    "generate": "node scripts/generate-invoice.js",
    "generate:hbs": "node scripts/generate-invoice-hbs.js",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "fastmcp": "^4.20.16",
    "handlebars": "^4.7.8",
    "marked": "^15.0.12",
    "puppeteer-core": "^24.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  }
}
